# Network. Keep 127.0.0.1 when a reverse proxy terminates HTTPS.
GBM_HOST=127.0.0.1
GBM_PORT=8011
# Local HTTP testing uses false. Set true behind a production HTTPS proxy.
GBM_COOKIE_SECURE=false
GBM_ENABLE_API_DOCS=false

# Runtime paths. The default is ./data and SQLite is suitable for one process.
GBM_RUNTIME_DIR=./data
# GBM_DATABASE_URL=sqlite:////absolute/path/workspace.db
# Production PostgreSQL example:
# GBM_DATABASE_URL=postgresql+psycopg://gbm:change-me@postgres:5432/gbm

# Prefer explicit externally managed secrets in production. A local 0600 key
# file is generated when this is omitted.
# GBM_APP_CREDENTIAL_ENCRYPTION_KEY=<32-byte-base64url-or-64-hex>
# GBM_APP_JWT_SECRET=<long-random-secret>

# Optional non-secret defaults. Provider API keys are configured encrypted in
# the administrator interface/API and should not be committed here.
GBM_CONFIG_DEFAULT_EXECUTOR=headless
GBM_CONFIG_DEFAULT_PROXY=
DRISSION_BROWSER_PATH=/usr/bin/chromium
